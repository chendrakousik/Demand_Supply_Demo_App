{
  "name": "siliconflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "api": "node --env-file-if-exists=.env server/index.ts",
    "lint": "tsc --noEmit",
    "build": "vite build",
    "test": "node --test --test-concurrency=1 tests/*.test.ts",
    "start": "node server/index.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.0",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "jose": "^6.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "snowflake-sdk": "^3.4.1"
  },
  "overrides": {
    "exceljs": { "uuid": "^11.1.1" }
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
