# Local demo is loopback-only and must be explicitly enabled.
SF_DEMO=1
PORT=3000

# To try local sign-in with a real development Snowflake database:
# SF_DEMO_DATA=snowflake
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_ROLE=SILICONFLOW_API
# SNOWFLAKE_DATABASE=SILICONFLOW_DEV
# SNOWFLAKE_WAREHOUSE=SILICONFLOW_DEV_WH
# SNOWFLAKE_PRIVATE_KEY_PATH=
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Managed mode requires these values and approved policies.
# SF_POLICIES_APPROVED=1
# APP_ORIGIN=https://your-siliconflow-host.example
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ROLE_CLAIM=
# OIDC_EMAIL_PARAMETERS=
# OIDC_GOOGLE_PARAMETERS=
# OIDC_MICROSOFT_PARAMETERS=
